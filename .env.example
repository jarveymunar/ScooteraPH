# SCOOTERA CAFÉ POS & MANAGEMENT CONFIGURATION
# Copy this file to .env.local for Next.js or .env for local preview

# 1. Supabase Public Client Credentials (Vercel & Browser)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Also supported for Vite preview environment:
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 2. Supabase Private Service Role Key (SERVER ONLY - NEVER expose to client/browser!)
# Used by Next.js Route Handlers, Cron jobs, and Admin User Provisioning
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 3. Vercel Cron Security Secret (Protect /api/cron/generate-recurring-expenses)
# Generate a secure 32+ character random string (e.g., openssl rand -base64 32)
CRON_SECRET="scootera_super_secret_cron_token_32chars_min"

# 4. App URL (Configured automatically by Vercel or Cloud Run)
NEXT_PUBLIC_APP_URL="https://your-app-domain.vercel.app"
APP_URL="https://your-app-domain.vercel.app"
